# Copy to .env.local for local development, and add the same names in Vercel's project settings.

# Supabase project URL and publishable (anon) key: Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY also works in place of the publishable key.

# Server-only, used by the invite and support emails in api/. Resend: https://resend.com
RESEND_API_KEY=
EMAIL_FROM="ChoreReward <noreply@yourdomain.com>"
SUPPORT_EMAIL=support@flogenixai.com
APP_URL=https://your-app.vercel.app
